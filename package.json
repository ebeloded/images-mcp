{
  "name": "@ebeloded/image-gen",
  "version": "2.3.0",
  "packageManager": "bun@1.4.0",
  "description": "CLI for AI image generation using OpenAI, Google Gemini, and xAI Grok",
  "type": "module",
  "bin": {
    "img": "cli.ts",
    "image-gen": "cli.ts"
  },
  "files": [
    "cli.ts",
    "config.ts",
    "core.ts",
    "core-utils.ts",
    "gemini.ts",
    "grok.ts",
    "keyring.ts",
    "keys.ts",
    "metadata.ts",
    "openai.ts",
    "schemas.ts",
    "skills"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check:pack": "bun pm pack --dry-run",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "ci:check": "bun run verify"
  },
  "keywords": [
    "ai",
    "cli",
    "image-generation",
    "openai",
    "gemini",
    "grok",
    "gpt-image"
  ],
  "author": "ebeloded",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhendalf/image-gen.git"
  },
  "bugs": {
    "url": "https://github.com/zhendalf/image-gen/issues"
  },
  "homepage": "https://github.com/zhendalf/image-gen#readme",
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@inquirer/prompts": "^8.6.0",
    "commander": "^15.0.0",
    "openai": "^7.5.0",
    "zod": "^4.4.3"
  }
}
